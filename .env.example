# Required: the password you log in with. Use something long and unique.
ADMIN_PASSWORD=

# Recommended: a long random string so you stay logged in across restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
# SITE_TITLE=Tools
# PORT=3000
# DATA_DIR=./data
